# This is a template showing all environment variables used across services
# Copy relevant sections to backend/.env and frontend/.env

# =============================================================================
# BACKEND ENVIRONMENT VARIABLES
# =============================================================================

# Database (provided by Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Kite API
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Zerodha Auto-Login (for token refresh)
KITE_USER_ID=your_zerodha_client_id
KITE_PASSWORD=your_zerodha_password
KITE_TOTP_SECRET=your_totp_secret

# Environment
ENVIRONMENT=development


# Debug Mode
DEBUG=True
DB_ECHO=False

# Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email
SMTP_PASSWORD=your-email-password